<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<eagle version="9.7.0">
<drawing>
<settings><setting alwaysvectorfont="no"/><setting verticaltext="up"/></settings>
<grid distance="0.1" unitdist="inch" unit="inch" style="lines" multiple="1" display="no" altdistance="0.01" altunitdist="inch" altunit="inch"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="17" name="Pads" color="2" fill="1" visible="yes" active="yes"/>
<layer number="93" name="Pins" color="2" fill="1" visible="yes" active="yes"/>
<layer number="94" name="Symbols" color="4" fill="1" visible="yes" active="yes"/>
<layer number="95" name="Names" color="7" fill="1" visible="yes" active="yes"/>
</layers>
<library>
<description>Passive routing and multi-gate fixtures</description>
<packages>
<package name="PASSIVE_SMD">
<smd name="1" x="-1.5" y="0" dx="1.2" dy="1.4" layer="1"/>
<smd name="2" x="1.5" y="0" dx="1.2" dy="1.4" layer="1"/>
</package>
<package name="PASSIVE_THT">
<pad name="1" x="-1.5" y="0" drill="0.8" diameter="1.6"/>
<pad name="2" x="1.5" y="0" drill="0.8" diameter="1.6"/>
</package>
</packages>
<symbols>
<symbol name="PASSIVE">
<wire x1="-2.54" y1="1.27" x2="2.54" y2="1.27" width="0.254" layer="94"/>
<wire x1="2.54" y1="1.27" x2="2.54" y2="-1.27" width="0.254" layer="94"/>
<wire x1="2.54" y1="-1.27" x2="-2.54" y2="-1.27" width="0.254" layer="94"/>
<wire x1="-2.54" y1="-1.27" x2="-2.54" y2="1.27" width="0.254" layer="94"/>
<pin name="1" x="-5.08" y="0" length="short" direction="pas"/>
<pin name="2" x="5.08" y="0" length="short" direction="pas" rot="R180"/>
<text x="-2.54" y="2.54" size="1.27" layer="95">&gt;NAME</text>
</symbol>
<symbol name="TERMINAL">
<circle x="0" y="0" radius="0.75" width="0.254" layer="94"/>
<pin name="P" x="-2.54" y="0" length="short" direction="pas"/>
<text x="-2.54" y="2.54" size="1.27" layer="95">&gt;NAME</text>
</symbol>
</symbols>
<devicesets>
<deviceset name="RESISTOR" prefix="R" uservalue="yes">
<gates><gate name="G$1" symbol="PASSIVE" x="0" y="0"/></gates>
<devices>
<device name="SMD" package="PASSIVE_SMD">
<connects><connect gate="G$1" pin="1" pad="1"/><connect gate="G$1" pin="2" pad="2"/></connects>
<technologies><technology name=""/></technologies>
</device>
<device name="THT" package="PASSIVE_THT">
<connects><connect gate="G$1" pin="1" pad="1"/><connect gate="G$1" pin="2" pad="2"/></connects>
<technologies><technology name=""/></technologies>
</device>
</devices>
</deviceset>
<deviceset name="DUAL_TERMINAL" prefix="U" uservalue="yes">
<gates>
<gate name="A" symbol="TERMINAL" x="0" y="0" addlevel="must"/>
<gate name="B" symbol="TERMINAL" x="0" y="-5.08" addlevel="must"/>
</gates>
<devices><device name="" package="PASSIVE_SMD">
<connects><connect gate="A" pin="P" pad="1"/><connect gate="B" pin="P" pad="2"/></connects>
<technologies><technology name=""/></technologies>
</device></devices>
</deviceset>
</devicesets>
</library>
</drawing>
</eagle>
