{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Fusion Electronics Design v1",
  "description": "Shape of the version-1 compiler input. The offline runtime additionally checks exact numeric types, reference integrity, pinned assets, and resolved EAGLE contacts.",
  "type": "object",
  "required": ["version","name","units","templates","libraries","parts","schematic","board","nets","routing"],
  "additionalProperties": false,
  "properties": {
    "version": {"type":"integer","const":1},
    "name": {"$ref":"#/$defs/identifier"},
    "units": {"const":"mm"},
    "align_50mil": {"type":"boolean","default":false,"description":"Align schematic and board component origins to the 50 mil placement grid."},
    "templates": {
      "type": "object",
      "required": ["schematic","board"],
      "additionalProperties": false,
      "properties": {"schematic":{"$ref":"#/$defs/asset"},"board":{"$ref":"#/$defs/asset"}}
    },
    "libraries": {"type":"array","items":{"$ref":"#/$defs/library"}},
    "parts": {"type":"array","items":{"$ref":"#/$defs/part"}},
    "schematic": {
      "type": "object",
      "required": ["sheets"],
      "additionalProperties": false,
      "properties": {"sheets":{"type":"array","items":{"$ref":"#/$defs/sheet"}}}
    },
    "board": {"$ref":"#/$defs/board"},
    "nets": {"type":"array","items":{"$ref":"#/$defs/net"}},
    "routing": {"$ref":"#/$defs/routing"}
  },
  "$defs": {
    "identifier": {"type":"string","pattern":"^[A-Za-z0-9_.$@+!~-]+(?![\\s\\S])"},
    "asset": {
      "type": "object",
      "required": ["path","sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?![\\s\\S]*\\x00)(?:/|[A-Za-z]:[/\\\\]|\\\\\\\\[^\\\\]+\\\\[^\\\\]+)",
          "description": "Absolute POSIX, Windows drive, or Windows UNC path"
        },
        "sha256": {"type":"string","pattern":"^[a-fA-F0-9]{64}(?![\\s\\S])"}
      }
    },
    "library": {
      "type": "object",
      "required": ["name","path","sha256"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref":"#/$defs/identifier"},
        "path": {
          "type": "string",
          "pattern": "^(?![\\s\\S]*\\x00)(?:/|[A-Za-z]:[/\\\\]|\\\\\\\\[^\\\\]+\\\\[^\\\\]+)",
          "description": "Absolute POSIX, Windows drive, or Windows UNC path"
        },
        "sha256": {"type":"string","pattern":"^[a-fA-F0-9]{64}(?![\\s\\S])"}
      }
    },
    "point": {"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2},
    "sheet": {
      "type": "object",
      "required": ["number"],
      "additionalProperties": false,
      "properties": {"number":{"type":"integer","minimum":1},"description":{"type":"string"}}
    },
    "unit": {
      "type": "object",
      "required": ["gate","sheet","x","y","rotation"],
      "additionalProperties": false,
      "properties": {
        "gate": {"$ref":"#/$defs/identifier"},
        "sheet": {"type":"integer","minimum":1},
        "x": {"type":"number"},
        "y": {"type":"number"},
        "rotation": {"enum":[0,90,180,270]}
      }
    },
    "placement": {
      "type": "object",
      "required": ["x","y","rotation","side","fixed"],
      "additionalProperties": false,
      "properties": {
        "x": {"type":"number"},
        "y": {"type":"number"},
        "rotation": {"type":"number","minimum":0,"exclusiveMaximum":360},
        "side": {"enum":["top","bottom"]},
        "fixed": {"type":"boolean"},
          "allow_outside": {"type":"boolean","default":false}
      }
    },
    "part": {
      "type": "object",
      "required": ["ref","library","deviceset","device","technology","value","attributes","units","board"],
      "additionalProperties": false,
      "properties": {
        "ref": {"$ref":"#/$defs/identifier"},
        "library": {"$ref":"#/$defs/identifier"},
        "deviceset": {"$ref":"#/$defs/identifier"},
        "device": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.$@+!~-]*(?![\\s\\S])",
          "description": "Use the empty string to select an unnamed EAGLE device."
        },
        "technology": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.$@+!~-]*(?![\\s\\S])",
          "description": "Use the empty string to select the unnamed EAGLE technology."
        },
        "value": {"type":"string"},
        "attributes": {"type":"object","propertyNames":{"$ref":"#/$defs/identifier"},"additionalProperties":{"type":"string"}},
        "units": {"type":"array","items":{"$ref":"#/$defs/unit"},"minItems":1},
        "board": {"anyOf":[{"$ref":"#/$defs/placement"},{"type":"null"}]}
      }
    },
    "hole": {
      "type": "object",
      "required": ["x","y","drill"],
      "additionalProperties": false,
      "properties": {"x":{"type":"number"},"y":{"type":"number"},"drill":{"type":"number","exclusiveMinimum":0}}
    },
    "keepout": {
      "type": "object",
      "required": ["vertices","layers"],
      "additionalProperties": false,
      "properties": {
        "vertices": {"type":"array","items":{"$ref":"#/$defs/point"},"minItems":3},
        "layers": {"type":"array","items":{"type":"integer","minimum":1,"maximum":304},"minItems":1,"uniqueItems":true}
      }
    },
    "netClass": {
      "type": "object",
      "required": ["number","name","width","drill"],
      "additionalProperties": false,
      "properties": {
        "number": {"type":"integer","minimum":0,"maximum":15},
        "name": {"$ref":"#/$defs/identifier"},
        "width": {"type":"number","minimum":0},
        "drill": {"type":"number","minimum":0},
        "clearances": {
          "type": "object",
          "propertyNames": {"$ref":"#/$defs/identifier"},
          "additionalProperties": {"type":"number","minimum":0}
        }
      }
    },
    "pour": {
      "type": "object",
      "required": ["net","layer","vertices","width"],
      "additionalProperties": false,
      "properties": {
        "net": {"$ref":"#/$defs/identifier"},
        "layer": {"type":"integer","minimum":1,"maximum":304},
        "vertices": {"type":"array","items":{"$ref":"#/$defs/point"},"minItems":3},
        "width": {"type":"number","exclusiveMinimum":0},
        "isolate": {"type":"number","minimum":0},
        "rank": {"type":"integer","minimum":1,"maximum":6},
        "thermals": {"type":"boolean"},
        "orphans": {"type":"boolean"}
      }
    },
    "board": {
      "type": "object",
      "required": ["outline","holes","keepouts","placements","net_classes","pours"],
      "additionalProperties": false,
      "properties": {
        "copper_layers": {"type":"array","items":{"type":"integer","minimum":1,"maximum":304},"minItems":2,"uniqueItems":true},
        "outline": {"anyOf":[{"const":[]},{"type":"array","items":{"$ref":"#/$defs/point"},"minItems":3}]},
        "holes": {"type":"array","items":{"$ref":"#/$defs/hole"}},
        "keepouts": {"type":"array","items":{"$ref":"#/$defs/keepout"}},
        "placements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref","x","y","rotation","side","fixed"],
            "additionalProperties": false,
            "properties": {
              "ref": {"$ref":"#/$defs/identifier"},
              "x": {"type":"number"},
              "y": {"type":"number"},
              "rotation": {"type":"number","minimum":0,"exclusiveMaximum":360},
              "side": {"enum":["top","bottom"]},
              "fixed": {"type":"boolean"},
          "allow_outside": {"type":"boolean","default":false}
            }
          }
        },
        "net_classes": {"type":"array","items":{"$ref":"#/$defs/netClass"}},
        "pours": {"type":"array","items":{"$ref":"#/$defs/pour"}}
      }
    },
    "pin": {
      "type": "object",
      "required": ["part","gate","pin"],
      "additionalProperties": false,
      "properties": {
        "part": {"$ref":"#/$defs/identifier"},
        "gate": {"$ref":"#/$defs/identifier"},
        "pin": {"$ref":"#/$defs/identifier"}
      }
    },
    "wire": {
      "type": "object",
      "required": ["x1","y1","x2","y2","layer","width"],
      "additionalProperties": false,
      "properties": {
        "x1": {"type":"number"},
        "y1": {"type":"number"},
        "x2": {"type":"number"},
        "y2": {"type":"number"},
        "layer": {"type":"integer","minimum":1,"maximum":304},
        "width": {"type":"number","exclusiveMinimum":0}
      }
    },
    "via": {
      "type": "object",
      "required": ["x","y","drill","extent"],
      "additionalProperties": false,
      "properties": {
        "x": {"type":"number"},
        "y": {"type":"number"},
        "drill": {"type":"number","exclusiveMinimum":0},
        "extent": {"type":"string","pattern":"^[1-9][0-9]{0,2}-[1-9][0-9]{0,2}(?![\\s\\S])"},
        "diameter": {"type":"number","minimum":0}
      }
    },
    "net": {
      "type": "object",
      "required": ["name","class","pins","schematic_style","route"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref":"#/$defs/identifier"},
        "class": {"$ref":"#/$defs/identifier"},
        "pins": {"type":"array","items":{"$ref":"#/$defs/pin"},"minItems":1,"uniqueItems":true},
        "schematic_style": {"enum":["wired","labels"]},
        "port": {"enum":["inter-block","inter-sheet"]},
        "route": {"type":"boolean"},
        "wires": {"type":"array","items":{"$ref":"#/$defs/wire"}},
        "vias": {"type":"array","items":{"$ref":"#/$defs/via"}}
      },
      "if": {"properties":{"schematic_style":{"const":"labels"}}},
      "then": {"required":["port"]}
    },
    "routing": {
      "type": "object",
      "required": ["selected_nets","protected_nets","policies","budget"],
      "additionalProperties": false,
      "properties": {
        "selected_nets": {"type":"array","items":{"$ref":"#/$defs/identifier"},"uniqueItems":true},
        "protected_nets": {"type":"array","items":{"$ref":"#/$defs/identifier"},"uniqueItems":true},
        "matched_pairs": {
          "description": "Intentional Fusion automatic pairs, ordered as positive _P and negative _N net names.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"$ref":"#/$defs/identifier"}
          }
        },
        "policies": {
          "type": "object",
          "propertyNames": {"$ref":"#/$defs/identifier"},
          "additionalProperties": {
            "type": "object",
            "required": [],
            "additionalProperties": false,
            "properties": {
              "allowed_layers": {
                "type": "array",
                "items": {"type":"integer","minimum":1,"maximum":304},
                "minItems": 1,
                "uniqueItems": true
              },
              "max_vias_per_connection": {"type":"integer","minimum":1,"maximum":8},
              "min_width_mm": {"type":"number","exclusiveMinimum":0},
              "via_spans": {"type":"array","maxItems":1,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1,"maximum":304}}}
            }
          }
        },
        "budget": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "max_nodes_per_attempt": {"type":"integer","minimum":1,"maximum":1000000,"default":200000},
            "max_nodes_per_connection": {"type":"integer","minimum":1,"maximum":2000000,"default":300000},
            "max_attempts_per_connection": {"type":"integer","minimum":1,"maximum":8,"default":2},
            "max_seconds_per_attempt": {"type":"number","exclusiveMinimum":0,"maximum":60,"default":15},
            "max_seconds_per_job": {"type":"number","exclusiveMinimum":0,"maximum":1800,"default":600},
            "max_vias_per_connection": {"type":"integer","minimum":1,"maximum":8,"default":2},
            "ripup_rounds": {"type":"integer","minimum":1,"maximum":8,"default":2}
          }
        },
        "require_fully_routed": {"type":"boolean"}
      }
    }
  }
}
