{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-linked design requirements v1",
  "type": "object",
  "required": ["version", "sources", "devices", "operating_conditions", "requirements"],
  "properties": {
    "version": {"const": 1},
    "sources": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["manifest_path", "sha256"],
      "properties": {"manifest_path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    }},
    "devices": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["mpn", "package"],
      "properties": {"mpn": {"type": "string", "minLength": 1}, "package": {"type": "string", "minLength": 1},
        "pin_evidence_path": {"type": "string"}, "part_path": {"type": "string"}, "value": {"type": "string"}}
    }},
    "operating_conditions": {"type": "object", "description": "Explicit actual conditions in SI units; e.g. vin_v, temperature_c, bias_v, switching_hz, duty_cycle."},
    "components": {"type": "object", "description": "REF -> parameters -> metric -> worst-case min/max plus source/pages/conditions. Use SI units; include tolerance, bias, temperature and frequency where relevant."},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}}
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "type", "device", "origin", "statement", "source", "pages", "conditions"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "device": {"type": "string"},
        "type": {"type": "string", "description": "distance, separation, path_length, loop, keepout, selection, routing, thermal_vias, pour. Other types (return_path, thermal_analysis, soa, missing_document) report unverified."},
        "origin": {"enum": ["manufacturer", "assumption"]},
        "statement": {"type": "string", "minLength": 1}, "rationale": {"type": "string"},
        "source": {"type": "string"}, "pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "conditions": {"type": "object", "minProperties": 1},
        "pads": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^.+\\..+$"}},
        "pad": {"type": "string"}, "net": {"type": "string"}, "same_side": {"type": "boolean"},
        "min_mm": {"type": "number", "minimum": 0}, "max_mm": {"type": "number", "minimum": 0},
        "component": {"type": "string"}, "metric": {"type": "string"}, "min": {"type": "number"}, "max": {"type": "number"},
        "layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "layer": {"type": "integer", "minimum": 1},
        "min_width_mm": {"type": "number", "exclusiveMinimum": 0}, "clearance_mm": {"type": "number", "minimum": 0},
        "min_drill_mm": {"type": "number", "exclusiveMinimum": 0}, "min_diameter_mm": {"type": "number", "exclusiveMinimum": 0},
        "via_technology": {"type": "string"}, "allow_vias": {"type": "boolean"}, "priority": {"type": "number"},
        "via_spans": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}},
        "radius_mm": {"type": "number", "exclusiveMinimum": 0}, "min_count": {"type": "integer", "minimum": 1},
        "region_mm": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "allowed_nets": {"type": "array", "items": {"type": "string"}},
        "segments": {"type": "array", "minItems": 2, "description": "Loop wire paths: each {pads:[REF.PAD,REF.PAD],net}; component internal paths are excluded."},
        "solid": {"type": "boolean"}, "qualitative": {"type": "boolean"}
      },
      "allOf": [{"if": {"properties": {"origin": {"const": "assumption"}}}, "then": {"required": ["rationale"]}}]
    }
  }
}
